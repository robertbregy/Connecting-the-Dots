  "hubLeads": {
    "understand": {
      "it": "Un indirizzo familiare, poi il sistema che lo fa funzionare. Parti dalla guida quotidiana; passa alle regole solo quando ti servono.",
      "en": "A familiar address, then the system behind it. Start with everyday examples and move to the rules when you need them.",
      "de": "Eine vertraute Adresse, dann das System dahinter. Beginnen Sie mit Alltagsbeispielen und vertiefen Sie die Regeln nach Bedarf.",
      "fr": "Une adresse familière, puis le système qui la fait fonctionner. Partez du quotidien et abordez les règles selon vos besoins."
    },
    "explore": {
      "it": "Cerchi una storia o una prova? Il catalogo segue i nomi; l'atlante segue le singole candidature. Poi allarga lo sguardo a territori e potere.",
      "en": "Looking for a story or evidence? The catalogue follows names; the atlas follows individual applications. Then explore geography and power.",
      "de": "Suchen Sie eine Geschichte oder einen Beleg? Der Katalog folgt Namen, der Atlas einzelnen Anträgen. Danach geht es um Geografie und Macht.",
      "fr": "Vous cherchez une histoire ou une preuve ? Le catalogue suit les noms ; l'atlas suit les candidatures. Élargissez ensuite le regard aux territoires et au pouvoir."
    },
    "stories": {
      "it": "Una sigla può cambiare significato, rappresentare una comunità o diventare un mercato. Parti dalla sorpresa e segui le sue conseguenze.",
      "en": "A suffix can change meaning, represent a community or become a market. Start with a surprise and follow its consequences.",
      "de": "Eine Endung kann ihre Bedeutung wechseln, eine Gemeinschaft vertreten oder zum Markt werden. Beginnen Sie mit einer Überraschung und folgen Sie den Auswirkungen.",
      "fr": "Une extension peut changer de sens, représenter une communauté ou devenir un marché. Partez d'une surprise et suivez ses conséquences."
    },
    "outcomes": {
      "it": "Più richieste per lo stesso nome, interessi in conflitto, progetti interrotti. Segui il percorso senza confondere contesa, rifiuto e chiusura.",
      "en": "Several requests for one name, competing interests, projects that stop. Follow the process without confusing contention, refusal and closure.",
      "de": "Mehrere Anträge für einen Namen, widerstreitende Interessen, beendete Projekte. Unterscheiden Sie Namenskonkurrenz, Ablehnung und Schließung.",
      "fr": "Plusieurs demandes pour un nom, des intérêts opposés, des projets interrompus. Distinguez concurrence, refus et fermeture."
    },
    "round": {
      "it": "Prima il quadro generale, poi la cronologia e le verifiche. Ogni dato ha una data: una candidatura pubblicata non è un dominio già attivo.",
      "en": "First the overview, then the timeline and investigations. Every observation has a date: a published application is not an active domain.",
      "de": "Zuerst der Überblick, dann Chronologie und Prüfungen. Jede Beobachtung hat ein Datum: Ein veröffentlichter Antrag ist keine aktive Domain.",
      "fr": "D'abord la vue d'ensemble, puis la chronologie et les enquêtes. Chaque observation est datée : une candidature publiée n'est pas un domaine actif."
    },
    "research": {
      "it": "Verifica una tesi, scarica i dati o scegli la versione da citare. Il sito in evoluzione, il working paper e gli archivi scientifici restano distinti.",
      "en": "Check a claim, download the data or choose a version to cite. The evolving site, working paper and scientific archives remain distinct.",
      "de": "Prüfen Sie eine These, laden Sie Daten herunter oder wählen Sie eine zitierbare Version. Website, Arbeitspapier und Forschungsarchive bleiben getrennt.",
      "fr": "Vérifiez une thèse, téléchargez les données ou choisissez une version à citer. Le site, le document de travail et les archives scientifiques restent distincts."
    }
  },
